{
  "name": "pc-local",
  "private": true,
  "type": "module",
  "description": "Local PC capability agent (Arabic) — inspects hardware and suggests runnable local models",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "npx @cursor/bdk serve --dir . --mode single --dev --port 3847",
    "validate": "npx @cursor/bdk validate --dir .",
    "call:specs": "npx @cursor/bdk call pc_specs --dir . --input {}"
  },
  "dependencies": {
    "@cursor/bdk": "^0.2.24",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  }
}
